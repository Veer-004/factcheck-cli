# Template for .env - copy to .env and fill in. Never commit real keys.
# Read by: factcheck CLI, python -m factcheck.diagnostics, eval/run_eval.py (live splits).
# Format: KEY=value  (no spaces around the key, no quotes needed)

# --- API keys ---
GEMINI_API_KEY=
TAVILY_API_KEY=

# --- LLM provider: gemini (default) or ollama (local only, no Gemini key needed) ---
FACTCHECK_PROVIDER=gemini
# FACTCHECK_MODEL=gemini-3.8-flash

# --- Local fallback via Ollama (used when Gemini fails for an operational reason) ---
# FACTCHECK_OLLAMA_FALLBACK=true
# FACTCHECK_OLLAMA_URL=http://localhost:11434
# FACTCHECK_OLLAMA_MODEL=qwen3:4b
# FACTCHECK_OLLAMA_TIMEOUT=90
