# Copy to .env.local to override. Where the FastAPI backend runs (uvicorn factcheck_api.app:app).
VITE_API_BASE_URL=http://127.0.0.1:8000
# Upload limits shown in the UI and checked before uploading. Keep equal to the backend's
# FACTCHECK_API_MAX_*_MB settings (the backend enforces its own limits either way).
VITE_MAX_IMAGE_MB=25
VITE_MAX_VIDEO_MB=500
VITE_MAX_AUDIO_MB=500
# Demo sign-in (static, no database). Front-end gate only: these values end up in the JS bundle and
# the API itself does not require a login, so this is not security.
VITE_DEMO_USER=admin
VITE_DEMO_PASSWORD=admin123
